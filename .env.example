# Banco usado pelo PostgreSQL e pelo Django
DB_NAME=varzea_pro
DB_USER=postgres
DB_PASSWORD=postgres

# Porta publicada no host para acesso direto ao PostgreSQL (opcional)
DB_PORT_HOST=5432
API_PORT_HOST=8000

# Configuração do Django
SECRET_KEY=change-this-in-local-environment
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# URL que será embutida no bundle do Expo.
# Para um celular físico, use o IP da máquina na rede local, por exemplo:
# API_URL=http://192.168.0.10:8000/api
API_URL=http://localhost:8000/api
BASE_URL=http://localhost:8000

# IP da máquina na rede local para o QR Code do Expo em celular físico
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.0.10
